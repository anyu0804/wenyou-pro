{
	"name": "@percho/desktop",
	"version": "0.2.5",
	"private": true,
	"description": "司命 · 文游 Pro (Wenyou Pro) Desktop Workbench",
	"author": "安钰 (Based on Percho MIT)",
	"license": "MIT",
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "node ../../scripts/dev-desktop.mjs",
		"predev": "npm run build:sandbox",
		"build:sandbox": "npm --prefix ../pixi-sandbox run build:desktop",
		"build": "npm run build:sandbox && electron-vite build",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test": "vitest run",
		"dist": "node ../../scripts/package-release.mjs",
		"dist:beta": "node ../../scripts/package-release.mjs --channel beta",
		"icons": "node ../../scripts/generate-app-icons.mjs",
		"start": "electron-vite preview"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.5.1",
		"@earendil-works/pi-coding-agent": "1.5.1",
		"@percho/backend": "*",
		"@percho/shared": "*",
		"electron-updater": "^6.8.9"
	},
	"devDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@lexical/extension": "0.52.0",
		"@lexical/history": "0.52.0",
		"@lexical/react": "0.52.0",
		"@lexical/rich-text": "0.52.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.1.1",
		"electron": "43.3.0",
		"electron-builder": "^26.0.0",
		"electron-vite": "^5.0.0",
		"esbuild": "0.25.12",
		"happy-dom": "^21.0.4",
		"lexical": "0.52.0",
		"markstream-react": "^0.0.55",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"stream-markdown": "^0.0.16",
		"tailwindcss": "^4.3.3",
		"thinking-orbs": "^0.3.1",
		"typescript": "^5.9.0",
		"vite": "^7.0.0",
		"vitest": "^3.2.0",
		"zustand": "^5.0.14"
	}
}
