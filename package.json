{
	"name": "percho",
	"private": true,
	"version": "0.2.6",
	"description": "司命 · 文游 Pro (Wenyou Pro) standalone desktop workbench (based on Percho MIT)",
	"license": "MIT",
	"author": "安钰 (Based on Percho by Jaxton07)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anyu0804/wenyou-pro.git"
	},
	"bugs": "https://github.com/anyu0804/wenyou-pro/issues",
	"workspaces": [
		"packages/shared",
		"packages/backend",
		"packages/desktop"
	],
	"scripts": {
		"dev": "npm run dev -w packages/desktop",
		"postinstall": "patch-package && node node_modules/electron/install.js",
		"build": "npm run build -w packages/desktop",
		"typecheck": "npm run typecheck --workspaces",
		"test": "npm run test:release && npm run test --workspaces --if-present",
		"test:release": "node --test scripts/release/*.test.mjs",
		"test:perf": "node --import ./scripts/performance/test-setup.mjs --test scripts/performance/*.test.mjs",
		"perf": "node scripts/performance.mjs",
		"splash:textures": "node scripts/generate-splash-textures.mjs",
		"package:release": "node scripts/package-release.mjs",
		"package:beta": "node scripts/package-release.mjs --channel beta",
		"icons:wenyou": "node scripts/wenyou-release/generate-wenyou-icons.mjs",
		"package:wenyou": "node scripts/wenyou-release/build-installer.mjs",
		"package:wenyou:mac": "node scripts/wenyou-release/build-installer.mjs --platform mac",
		"package:wenyou:verify": "node scripts/wenyou-release/verify-package.mjs",
		"package:wenyou:verify:mac": "node scripts/wenyou-release/verify-package.mjs --platform mac",
		"check:paths": "node scripts/wenyou-release/scan-repo-paths.mjs",
		"repo:guard": "node scripts/wenyou-release/configure-github-repo.mjs --verify",
		"shortcut:sync": "node scripts/wenyou-release/sync-shortcut.mjs",
		"dist": "npm run package:release --",
		"dist:beta": "npm run package:beta --",
		"lint": "biome check ."
	},
	"engines": {
		"node": ">=22.19"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@electron/asar": "^3.4.1",
		"esbuild": "0.25.12",
		"patch-package": "^8.0.1",
		"pngjs": "^7.0.0"
	},
	"allowScripts": {
		"electron@43.3.0": true
	}
}
